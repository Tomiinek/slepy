{
  "name": "color-vision-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A dark-themed, offline color vision deficiency test with a detailed personalized report.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview:stimuli": "mkdir -p preview && vite-node scripts/preview-plate.mjs && vite-node scripts/preview-brightness.mjs",
    "preview:report": "mkdir -p preview && vite-node scripts/preview-report.tsx",
    "preview:link": "vite-node scripts/preview-link.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.11.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
